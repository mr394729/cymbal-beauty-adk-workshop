# ---- Google Cloud (required) -------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Gemini 3.x models are served from the global endpoint. Regional locations return 404.
GOOGLE_CLOUD_LOCATION=global
# Agent Runtime (Agent Engine) region for deployments and BigQuery dataset location
AGENT_ENGINE_LOCATION=us-central1
BQ_LOCATION=US

# ---- Workshop environment -----------------------------------------------------
# Your namespace: every dataset, engine, data store and topic you create carries it, so a shared project never
# collides. `make namespace` fills it from a hash of your sign-in; `make namespace NS=alex` picks your own.
WORKSHOP_NAMESPACE=
# dev | preprod | prod  (selects config/envs/<env>.yaml; datasets are cymbal_beauty_<namespace>_<env>)
STORE_OPS_ENV=dev
MODEL=gemini-3.8-flash
# Optional: inject a deterministic fault for the evaluation lab (stale_stock | none)
STORE_OPS_FAULT=none
# Optional: the store SOP data store in Vertex AI Search. Set it to the value `make sops` prints to give the store
# manager's assistant its policy_lookup tool; leave it unset and the tool is not registered.
SOP_DATA_STORE=
